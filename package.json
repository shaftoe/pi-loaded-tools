{
  "name": "@alexanderfortin/pi-loaded-tools",
  "author": "Alexander Fortin",
  "version": "0.4.8",
  "description": "Pi coding agent extension for listing loaded tools with source provenance",
  "keywords": [
    "pi-package",
    "tools",
    "list-tools"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "license": "MIT",
  "pi": {
    "extensions": [
      "./dist/index.js"
    ]
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "package.json",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-tui": "*",
    "@sinclair/typebox": "*"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/shaftoe/pi-loaded-tools"
  },
  "scripts": {
    "build": "bun run check && rm -rf dist && tsc --project tsconfig.build.json",
    "check": "tsc --noEmit",
    "check:watch": "tsc --noEmit --watch",
    "lint": "eslint . --ext .ts",
    "lint:fix": "eslint . --ext .ts --fix",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "test": "bun test",
    "test:coverage": "bun test --coverage --coverage-reporter=lcov",
    "test:watch": "bun test --watch",
    "release": "semantic-release",
    "release:dry-run": "semantic-release --dry-run",
    "validate": "bun run lint && bun run format && bun run check"
  },
  "devDependencies": {
    "@alexanderfortin/semantic-release-keep-a-changelog": "0.2.2",
    "@earendil-works/pi-ai": "0.75.3",
    "@earendil-works/pi-coding-agent": "0.75.3",
    "@earendil-works/pi-tui": "0.75.3",
    "@semantic-release/changelog": "6.0.3",
    "@semantic-release/commit-analyzer": "13.0.1",
    "@semantic-release/exec": "7.1.0",
    "@semantic-release/git": "10.0.1",
    "@semantic-release/github": "12.0.8",
    "@semantic-release/npm": "13.1.5",
    "@semantic-release/release-notes-generator": "14.1.1",
    "@sinclair/typebox": "0.34.49",
    "@types/bun": "1.3.14",
    "@types/node": "25.9.1",
    "@typescript-eslint/eslint-plugin": "8.59.4",
    "@typescript-eslint/parser": "8.59.4",
    "eslint": "10.4.0",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.8.3",
    "prettier-plugin-organize-imports": "4.3.0",
    "semantic-release": "25.0.3",
    "typescript": "6.0.3"
  },
  "dependencies": {}
}
